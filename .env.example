# Copy to .env and fill in the keys you have. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Primary model (default: gemini-3.5-flash-lite when a Gemini key is set).
# FRONTDESK_MODEL=gemini-3.5-flash-lite

# Backup chain, tried in order when a model fails, times out or runs out of quota. Gemini and Groq can be mixed
# (Groq ids start with "groq:"); models whose provider has no key are skipped.
# FRONTDESK_MODEL_FALLBACKS=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-120b,gemini-3-flash-preview,gemini-2.5-flash

# Speed: per-call timeout, overall deadline per message, and the longest rate-limit wait before switching model.
# FRONTDESK_CALL_TIMEOUT_S=8
# FRONTDESK_MESSAGE_DEADLINE_S=20
# FRONTDESK_MAX_RETRY_WAIT_S=3

# Spending guards. When either is reached the run alerts and stops calling the model;
# remaining messages use the rules fallback and are marked degraded.
FRONTDESK_MAX_COST_USD=2.00
# FRONTDESK_MAX_TOKENS=1500000

# Free-tier keys have low per-minute limits: cap requests per minute and parallel calls for batch runs.
# FRONTDESK_MAX_RPM=12
# FRONTDESK_CONCURRENCY=2

# FRONTDESK_MODE=llm
# FRONTDESK_TRANSPORT=inproc
