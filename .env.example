# Copy to .env and fill in ONE provider key. Never commit .env.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Model (default: gemini-2.5-flash when only a Gemini key is set, otherwise claude-opus-5-5)
# FRONTDESK_MODEL=gemini-2.5-flash

# Spending guards. When either is reached the run alerts and stops calling the model;
# remaining messages use the rules fallback and are marked degraded.
FRONTDESK_MAX_COST_USD=2.00
# FRONTDESK_MAX_TOKENS=1500000

# Free-tier Gemini keys have low per-minute limits: cap requests per minute and parallel calls.
# FRONTDESK_MAX_RPM=8
# FRONTDESK_CONCURRENCY=2

# FRONTDESK_MODE=llm
# FRONTDESK_TRANSPORT=inproc
